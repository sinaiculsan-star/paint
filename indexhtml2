ty:hidden;left:-9999px;';\n  tmp.innerHTML = svg;\n  document.body.appendChild(tmp);\n  const svgEl = tmp.querySelector('svg');\n  const vb = svgEl.getAttribute('viewBox').split(/\\s+/).map(Number);\n  const aspect = vb[2] / vb[3];\n  tmp.remove();\n\n  // Initial size based on font size & canvas size\n  let elW = Math.min(canvas.width * 0.7, Math.max(160, ftState.text.length * ftState.size * 0.55));\n  let elH = elW / aspect;\n  if (elH > canvas.height * 0.5) { elH = canvas.height * 0.5; elW = elH * aspect; }\n  const elX = (canvas.width - elW) / 2;\n  const elY = (canvas.height - elH) / 2;\n\n  const el = document.createElement('div');\n  el.className = 'text-art-floating';\n  el.style.left = elX + 'px';\n  el.style.top  = elY + 'px';\n  el.style.width = elW + 'px';\n  el.style.height = elH + 'px';\n  el.innerHTML = svg\n    + '<div class=\"ta-handle nw\" data-h=\"nw\"><\u002Fdiv>'\n    + '<div class=\"ta-handle ne\" data-h=\"ne\"><\u002Fdiv>'\n    + '<div class=\"ta-handle sw\" data-h=\"sw\"><\u002Fdiv>'\n    + '<div class=\"ta-handle se\" data-h=\"se\"><\u002Fdiv>'\n    + '<div class=\"ta-actions\">'\n      + '<div class=\"btn outset ta-commit\">Stamp<\u002Fdiv>'\n      + '<div class=\"btn outset ta-edit\">Edit...<\u002Fdiv>'\n      + '<div class=\"btn outset ta-cancel\">Cancel<\u002Fdiv>'\n    + '<\u002Fdiv>';\n  canvasFrame.appendChild(el);\n  ftState.floating = { el, aspect };\n\n  // Drag\n  let drag = null;\n  el.addEventListener('mousedown', (e) => {\n    if (e.target.closest('.ta-handle') || e.target.closest('.ta-actions')) return;\n    const r = el.getBoundingClientRect();\n    drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };\n    e.preventDefault();\n    e.stopPropagation();\n  });\n  function onMove(e) {\n    if (drag) {\n      const fr = canvasFrame.getBoundingClientRect();\n      const sx = canvas.width / fr.width;\n      const sy = canvas.height / fr.height;\n      let nx = (e.clientX - fr.left - drag.dx) * sx;\n      let ny = (e.clientY - fr.top  - drag.dy) * sy;\n      el.style.left = nx + 'px';\n      el.style.top  = ny + 'px';\n    }\n    if (resize) {\n      const fr = canvasFrame.getBoundingClientRect();\n      const sx = canvas.width / fr.width;\n      const sy = canvas.height / fr.height;\n      const mx = (e.clientX - fr.left) * sx;\n      const my = (e.clientY - fr.top) * sy;\n      let { x0, y0, x1, y1, dir } = resize;\n      if (dir.includes('e')) x1 = mx; if (dir.includes('w')) x0 = mx;\n      if (dir.includes('s')) y1 = my; if (dir.includes('n')) y0 = my;\n      let nw = Math.max(40, Math.abs(x1 - x0));\n      let nh = nw / ftState.floating.aspect;\n      // anchor based on dir\n      let nx = Math.min(x0, x1);\n      let ny = Math.min(y0, y1);\n      // keep aspect: adjust height anchor\n      if (dir.includes('n')) ny = (dir.includes('e') ? y1 - nh : (dir.includes('w') ? y1 - nh : ny));\n      el.style.left = nx + 'px';\n      el.style.top  = ny + 'px';\n      el.style.width  = nw + 'px';\n      el.style.height = nh + 'px';\n    }\n  }\n  function onUp() { drag = null; resize = null; }\n  let resize = null;\n  el.querySelectorAll('.ta-handle').forEach(h => {\n    h.addEventListener('mousedown', (e) => {\n      const fr = canvasFrame.getBoundingClientRect();\n      const sx = canvas.width / fr.width;\n      const sy = canvas.height / fr.height;\n      const x0c = parseFloat(el.style.left);\n      const y0c = parseFloat(el.style.top);\n      const x1c = x0c + parseFloat(el.style.width);\n      const y1c = y0c + parseFloat(el.style.height);\n      resize = { x0: x0c, y0: y0c, x1: x1c, y1: y1c, dir: h.dataset.h };\n      e.preventDefault();\n      e.stopPropagation();\n    });\n  });\n  document.addEventListener('mousemove', onMove);\n  document.addEventListener('mouseup', onUp);\n\n  // Buttons\n  el.querySelector('.ta-commit').addEventListener('mousedown', (e) => {\n    e.stopPropagation();\n    commitFloatingTextArt();\n  });\n  el.querySelector('.ta-cancel').addEventListener('mousedown', (e) => {\n    e.stopPropagation();\n    cancelFloatingTextArt();\n  });\n  el.querySelector('.ta-edit').addEventListener('mousedown', (e) => {\n    e.stopPropagation();\n    openFtInput(); // reopen the input dialog; commit will respawn floating\n  });\n}\n\nfunction cancelFloatingTextArt() {\n  if (!ftState.floating) return;\n  ftState.floating.el.remove();\n  ftState.floating = null;\n}\n\nfunction commitFloatingTextArt() {\n  if (!ftState.floating) return;\n  const el = ftState.floating.el;\n  const x = parseFloat(el.style.left);\n  const y = parseFloat(el.style.top);\n  const w = parseFloat(el.style.width);\n  const h = parseFloat(el.style.height);\n  const svgStr = el.querySelector('svg').outerHTML;\n  pushUndo();\n\n  // Render to canvas via image\n  const blob = new Blob([svgStr], { type: 'image/svg+xml' });\n  const url = URL.createObjectURL(blob);\n  const img = new Image();\n  img.onload = () => {\n    ctx.imageSmoothingEnabled = true;\n    ctx.drawImage(img, x, y, w, h);\n    URL.revokeObjectURL(url);\n    el.remove();\n    ftState.floating = null;\n  };\n  img.onerror = () => { URL.revokeObjectURL(url); el.remove(); ftState.floating = null; };\n  img.src = url;\n}\n\n/* Esc cancels floating text */\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'Escape' && ftState.floating) {\n    cancelFloatingTextArt();\n  }\n});\n\n/* When user clicks elsewhere on the canvas (not on the floating el), auto-commit */\ncanvas.addEventListener('mousedown', (e) => {\n  if (ftState.floating && !ftState.floating.el.contains(e.target)) {\n    // commit, but don't let this also trigger drawing\n    commitFloatingTextArt();\n    e.stopImmediatePropagation();\n    e.preventDefault();\n  }\n}, true);\n\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
