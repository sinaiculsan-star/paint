    <text x=\"8\" y=\"13\" text-anchor=\"middle\" font-family=\"Impact, Arial Black, sans-serif\" font-size=\"14\" font-weight=\"900\" font-style=\"italic\" fill=\"#fbbf24\" stroke=\"#000\" stroke-width=\"0.6\">A<\u002Ftext>\n      <\u002Fsvg>\n      <span class=\"title-text\">Edit Fancy Text<\u002Fspan>\n      <div class=\"controls\">\n        <div class=\"tb-btn outset-thin\" id=\"closeFtInput\">\n          <svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\" shape-rendering=\"crispEdges\"><path d=\"M1,1 L7,7 M7,1 L1,7\" stroke=\"#000\" stroke-width=\"1.2\" fill=\"none\"><\u002Fpath><\u002Fsvg>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div class=\"ft-input-body\">\n      <div class=\"ft-row\">\n        <label for=\"ftFont\"><span class=\"u\">F<\u002Fspan>ont:<\u002Flabel>\n        <select class=\"ft-select\" id=\"ftFont\" style=\"flex:1\">\n          <option value=\"Impact, 'Arial Black', sans-serif\">Impact<\u002Foption>\n          <option value=\"'Arial Black', Impact, sans-serif\">Arial Black<\u002Foption>\n          <option value=\"'Times New Roman', Times, serif\">Times New Roman<\u002Foption>\n          <option value=\"Georgia, serif\">Georgia<\u002Foption>\n          <option value=\"'Courier New', monospace\">Courier New<\u002Foption>\n          <option value=\"'Comic Sans MS', cursive\">Comic Sans MS<\u002Foption>\n          <option value=\"'Brush Script MT', cursive\">Brush Script<\u002Foption>\n          <option value=\"Verdana, sans-serif\">Verdana<\u002Foption>\n        <\u002Fselect>\n        <label for=\"ftSize\" style=\"min-width:40px\">Size:<\u002Flabel>\n        <select class=\"ft-select\" id=\"ftSize\" style=\"width:60px\">\n          <option>24<\u002Foption><option>32<\u002Foption><option>40<\u002Foption>\n          <option selected=\"\">54<\u002Foption><option>72<\u002Foption><option>96<\u002Foption><option>120<\u002Foption>\n        <\u002Fselect>\n      <\u002Fdiv>\n      <div class=\"ft-row\">\n        <label for=\"ftText\"><span class=\"u\">T<\u002Fspan>ext:<\u002Flabel>\n        <input class=\"ft-input\" id=\"ftText\" type=\"text\" value=\"Your Text Here\">\n      <\u002Fdiv>\n      <div class=\"ft-preview-label\">Preview:<\u002Fdiv>\n      <div class=\"ft-input-preview\" id=\"ftPreview\"><\u002Fdiv>\n    <\u002Fdiv>\n    <div class=\"ft-footer\">\n      <div class=\"btn outset\" id=\"ftInputOk\">OK<\u002Fdiv>\n      <div class=\"btn outset\" id=\"ftInputCancel\">Cancel<\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<!-- About modal -->\n<div class=\"modal-bg\" id=\"aboutModal\">\n  <div class=\"modal outset\">\n    <div class=\"title-bar\">\n      <span class=\"title-text\">About PixelPad<\u002Fspan>\n      <div class=\"controls\">\n        <div class=\"tb-btn outset-thin\" id=\"closeAbout\">\n          <svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\" shape-rendering=\"crispEdges\"><path d=\"M1,1 L7,7 M7,1 L1,7\" stroke=\"#000\" stroke-width=\"1.2\" fill=\"none\"><\u002Fpath><\u002Fsvg>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div class=\"modal-body\">\n      <svg width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" shape-rendering=\"crispEdges\">\n        <rect x=\"2\" y=\"6\" width=\"44\" height=\"36\" fill=\"#fff\" stroke=\"#000\"><\u002Frect>\n        <rect x=\"4\" y=\"8\" width=\"10\" height=\"6\" fill=\"#ff0000\"><\u002Frect>\n        <rect x=\"14\" y=\"8\" width=\"10\" height=\"6\" fill=\"#ffff00\"><\u002Frect>\n        <rect x=\"24\" y=\"8\" width=\"10\" height=\"6\" fill=\"#00aa00\"><\u002Frect>\n        <rect x=\"34\" y=\"8\" width=\"10\" height=\"6\" fill=\"#0000ff\"><\u002Frect>\n        <rect x=\"6\" y=\"18\" width=\"34\" height=\"2\" fill=\"#666\"><\u002Frect>\n        <rect x=\"6\" y=\"22\" width=\"24\" height=\"2\" fill=\"#666\"><\u002Frect>\n        <rect x=\"6\" y=\"26\" width=\"30\" height=\"2\" fill=\"#666\"><\u002Frect>\n        <rect x=\"6\" y=\"30\" width=\"18\" height=\"2\" fill=\"#666\"><\u002Frect>\n        <rect x=\"6\" y=\"34\" width=\"26\" height=\"2\" fill=\"#666\"><\u002Frect>\n      <\u002Fsvg>\n      <div>\n        <p><b>PixelPad<\u002Fb><\u002Fp>\n        <p>Version 1.0 — a tiny retro drawing app.<\u002Fp>\n        <p>Inspired by the chunky-bevel desktop era.<\u002Fp>\n        <p style=\"margin-top:10px; color:#444;\">© 1998 PixelPad Software<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div class=\"modal-footer\">\n      <div class=\"btn outset\" id=\"closeAboutOk\">OK<\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<script>\n/* ===================================================================\n   PixelPad — retro drawing app\n   =================================================================== */\n\n/* ---------- Tool definitions (icons inline-SVG, pixel style) ---------- */\nconst toolDefs = [\n  { id: 'select-free', name: 'Free-form Select',\n    icon: `<polyline points=\"2,8 3,5 6,3 9,2 12,4 13,8 11,12 8,13 5,12 3,10\" fill=\"none\" stroke=\"#000\" stroke-dasharray=\"1,1\"/>` },\n  { id: 'select-rect', name: 'Select',\n    icon: `<rect x=\"2\" y=\"3\" width=\"11\" height=\"9\" fill=\"none\" stroke=\"#000\" stroke-dasharray=\"2,1\"/>` },\n  { id: 'eraser', name: 'Eraser',\n    icon: `<polygon points=\"3,11 7,3 13,5 9,13\" fill=\"#fff\" stroke=\"#000\"/><polyline points=\"3,11 9,13\" stroke=\"#000\" fill=\"none\"/><rect x=\"2\" y=\"12\" width=\"9\" height=\"2\" fill=\"#ff80c0\" stroke=\"#000\"/>` },\n  { id: 'fill', name: 'Fill With Color',\n    icon: `<path d=\"M3,8 L8,3 L13,8 L8,13 Z\" fill=\"#ccc\" stroke=\"#000\"/><rect x=\"11\" y=\"9\" width=\"2\" height=\"4\" fill=\"#ff8800\"/><circle cx=\"12\" cy=\"13\" r=\"1\" fill=\"#0000aa\"/>` },\n  { id: 'picker', name: 'Pick Color',\n    icon: `<path d=\"M2,14 L4,12 L9,7 L11,9 L6,14 Z\" fill=\"#fff\" stroke=\"#000\"/><rect x=\"9\" y=\"3\" width=\"4\" height=\"4\" transform=\"rotate(45 11 5)\" fill=\"#888\" stroke=\"#000\"/>` },\n  { id: 'zoom', name: 'Magnifier',\n    icon: `<circle cx=\"6\" cy=\"6\" r=\"4\" fill=\"#fff\" stroke=\"#000\"/><line x1=\"9\" y1=\"9\" x2=\"14\" y2=\"14\" stroke=\"#000\" stroke-width=\"2\"/><line x1=\"4\" y1=\"6\" x2=\"8\" y2=\"6\" stroke=\"#000\"/><line x1=\"6\" y1=\"4\" x2=\"6\" y2=\"8\" stroke=\"#000\"/>` },\n  { id: 'pencil', name: 'Pencil',\n    icon: `<polygon points=\"2,13 3,10 11,2 13,4 5,12\" fill=\"#ffcc00\" stroke=\"#000\"/><polygon points=\"11,2 13,4 12,5 10,3\" fill=\"#888\" stroke=\"#000\"/><polygon points=\"2,13 3,10 5,12\" fill=\"#000\"/>` },\n  { id: 'brush', name: 'Brush',\n    icon: `<rect x=\"9\" y=\"3\" width=\"3\" height=\"4\" fill=\"#888\" stroke=\"#000\" transform=\"rotate(-30 10 5)\"/><polygon points=\"6,8 9,5 11,7 8,10\" fill=\"#000\" stroke=\"#000\"/><polyline points=\"3,14 6,11 8,13 5,15\" fill=\"#553300\" stroke=\"#000\"/>` },\n  { id: 'spray', name: 'Airbrush',\n    icon: `<polygon points=\"2,13 5,10 8,12 5,15\" fill=\"#888\" stroke=\"#000\"/><line x1=\"8\" y1=\"11\" x2=\"14\" y2=\"5\" stroke=\"#000\"/><circle cx=\"13\" cy=\"3\" r=\"0.5\" fill=\"#000\"/><circle cx=\"11\" cy=\"3\" r=\"0.5\" fill=\"#000\"/><circle cx=\"14\" cy=\"5\" r=\"0.5\" fill=\"#000\"/><circle cx=\"12\" cy=\"6\" r=\"0.5\" fill=\"#000\"/><circle cx=\"10\" cy=\"4\" r=\"0.5\" fill=\"#000\"/><circle cx=\"14\" cy=\"2\" r=\"0.5\" fill=\"#000\"/>` },\n  { id: 'text', name: 'Text',\n    icon: `<text x=\"3\" y=\"13\" font-family=\"serif\" font-weight=\"bold\" font-size=\"14\" fill=\"#000\">A<\u002Ftext>` },\n  { id: 'line', name: 'Line',\n    icon: `<line x1=\"2\" y1=\"13\" x2=\"13\" y2=\"2\" stroke=\"#000\" stroke-width=\"1.2\"/>` },\n  { id: 'curve', name: 'Curve',\n    icon: `<path d=\"M2,13 C5,2 11,2 13,13\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.2\"/>` },\n  { id: 'rect', name: 'Rectangle',\n    icon: `<rect x=\"2\" y=\"4\" width=\"11\" height=\"8\" fill=\"none\" stroke=\"#000\"/>` },\n  { id: 'polygon', name: 'Polygon',\n    icon: `<polygon points=\"3,12 2,5 7,2 12,5 13,11 8,14\" fill=\"none\" stroke=\"#000\"/>` },\n  { id: 'ellipse', name: 'Ellipse',\n    icon: `<ellipse cx=\"7.5\" cy=\"8\" rx=\"6\" ry=\"4.5\" fill=\"none\" stroke=\"#000\"/>` },\n  { id: 'rrect', name: 'Rounded Rectangle',\n    icon: `<rect x=\"2\" y=\"4\" width=\"11\" height=\"8\" rx=\"2.5\" ry=\"2.5\" fill=\"none\" stroke=\"#000\"/>` },\n];\n\n/* ---------- Color palette ---------- */\nconst paletteColors = [\n  // row 1\n  '#000000','#808080','#800000','#808000','#008000','#008080','#000080','#800080','#808040','#004040','#0080ff','#004080','#8000ff','#804000',\n  // row 2\n  '#ffffff','#c0c0c0','#ff0000','#ffff00','#00ff00','#00ffff','#0000ff','#ff00ff','#ffff80','#00ff80','#80ffff','#8080ff','#ff0080','#ff8040',\n];\n\n/* ---------- State ---------- */\nconst state = {\n  tool: 'pencil',\n  fg: '#000000',\n  bg: '#ffffff',\n  size: 1, // brush size index (0..3)\n  shapeStyle: 'outline', // outline | filled | both\n  isDrawing: false,\n  startX: 0, startY: 0,\n  lastX: 0, lastY: 0,\n  snapshot: null, // ImageData snapshot for previewing shapes\n  curveStage: 0,\n  curvePts: [],\n  polyPts: [],\n  undoStack: [],\n  redoStack: [],\n  textBox: null,\n};\n\nconst sizes = [1, 3, 5, 8];\nconst sprayDensity = 18;\n\n/* ---------- DOM ---------- */\nconst canvas = document.getElementById('drawCanvas');\nconst ctx = canvas.getContext('2d');\nconst overlay = document.getElementById('overlayCanvas');\nconst octx = overlay.getContext('2d');\nconst canvasFrame = document.getElementById('canvasFrame');\nconst toolGrid = document.getElementById('toolGrid');\nconst toolOptions = document.getElementById('toolOptions');\nconst paletteEl = document.getElementById('palette');\nconst ccFg = document.getElementById('ccFg');\nconst ccBg = document.getElementById('ccBg');\nconst sbHelp = document.getElementById('sbHelp');\nconst sbCoord = document.getElementById('sbCoord');\nconst sbSize = document.getElementById('sbSize');\nconst menuBar = document.getElementById('menuBar');\n\n/* ---------- Init canvas (white background) ---------- */\nfunction clearCanvas() {\n  ctx.fillStyle = '#ffffff';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n}\nclearCanvas();\nctx.imageSmoothingEnabled = false;\noctx.imageSmoothingEnabled = false;\n\n/* ---------- Build tool grid ---------- */\ntoolDefs.forEach(t => {\n  const el = document.createElement('div');\n  el.className = 'tool outset-thin';\n  el.dataset.tool = t.id;\n  el.title = t.name;\n  el.innerHTML = `<svg class=\"pi\" viewBox=\"0 0 16 16\" shape-rendering=\"crispEdges\">${t.icon}<\u002Fsvg>`;\n  el.addEventListener('mousedown', () => setTool(t.id));\n  toolGrid.appendChild(el);\n});\n\n/* ---------- Build palette ---------- */\npaletteColors.forEach(c => {\n  const sw = document.createElement('div');\n  sw.className = 'swatch';\n  sw.style.background = c;\n  sw.title = c;\n  sw.addEventListener('mousedown', (e) => {\n    if (e.button === 2) { setBg(c); e.preventDefault(); }\n    else { setFg(c); }\n  });\n  sw.addEventListener('contextmenu', e => { e.preventDefault(); setBg(c); });\n  paletteEl.appendChild(sw);\n});\n\n/* ---------- Tool selection ---------- */\nfunction setTool(id) {\n  // cleanup pending operations\n  finishPendingOps();\n  state.tool = id;\n  document.querySelectorAll('.tool').forEach(el => {\n    el.classList.toggle('active', el.dataset.tool === id);\n  });\n  buildToolOptions();\n  updateCursor();\n  const t = toolDefs.find(t => t.id === id);\n  sbHelp.textContent = t ? `${t.name} — ` + helpFor(id) : '';\n}\n\nfunction helpFor(id) {\n  const h = {\n    'pencil':'draws a free-form line one pixel wide.',\n    'brush':'draws using a brush with the selected shape and size.',\n    'eraser':'erases a portion of the picture.',\n    'fill':'fills an area with the current drawing color.',\n    'picker':'picks up a color from the picture for drawing.',\n    'zoom':'changes the magnification.',\n    'spray':'draws using an airbrush.',\n    'text':'inserts text into the picture.',\n    'line':'draws a straight line.',\n    'curve':'draws a curved line.',\n    'rect':'draws a rectangle.',\n    'polygon':'draws a polygon.',\n    'ellipse':'draws an ellipse.',\n    'rrect':'draws a rounded rectangle.',\n    'select-rect':'selects a rectangular part of the picture.',\n    'select-free':'selects a free-form part of the picture.',\n  };\n  return h[id] || '';\n}\n\nfunction updateCursor() {\n  const map = {\n    'pencil':'crosshair',\n    'brush':'crosshair',\n    'eraser':'cell',\n    'fill':'crosshair',\n    'picker':'crosshair',\n    'zoom':'zoom-in',\n    'spray':'crosshair',\n    'text':'text',\n    'line':'crosshair',\n    'curve':'crosshair',\n    'rect':'crosshair',\n    'polygon':'crosshair',\n    'ellipse':'crosshair',\n    'rrect':'crosshair',\n    'select-rect':'crosshair',\n    'select-free':'crosshair',\n  };\n  canvas.style.cursor = map[state.tool] || 'default';\n}\n\n/* ---------- Build tool options panel ---------- */\nfunction buildToolOptions() {\n  toolOptions.innerHTML = '';\n  const t = state.tool;\n\n  // Shape style for shape tools\n  if (['rect','ellipse','rrect','polygon'].includes(t)) {\n    const styles = [\n      { id:'outline', draw:(b) => { b.style.border = '1.5px solid #000'; } },\n      { id:'both',    draw:(b) => { b.style.background = '#888'; b.style.border = '1.5px solid #000'; } },\n      { id:'filled',  draw:(b) => { b.style.background = '#000'; } },\n    ];\n    styles.forEach(s => {\n      const wrap = document.createElement('div');\n      wrap.className = 'opt-line outset-thin' + (state.shapeStyle === s.id ? ' active' : '');\n      wrap.title = s.id;\n      const shape = document.createElement('div');\n      shape.style.width = '20px'; shape.style.height='8px';\n      if (t === 'ellipse') shape.style.borderRadius = '50%';\n      if (t === 'rrect') shape.style.borderRadius = '3px';\n      s.draw(shape);\n      wrap.appendChild(shape);\n      wrap.addEventListener('mousedown', () => { state.shapeStyle = s.id; buildToolOptions(); });\n      toolOptions.appendChild(wrap);\n    });\n    return;\n  }\n\n  // Brush sizes\n  if (['brush','eraser','pencil','line','curve','spray'].includes(t)) {\n    sizes.forEach((s, i) => {\n      const wrap = document.createElement('div');\n      wrap.className = 'opt-line outset-thin' + (state.size === i ? ' active' : '');\n      const dot = document.createElement('div');\n      if (t === 'spray') {\n        // show spray density circles\n        const sz = [5,8,12,16][i];\n        dot.style.width = sz+'px';\n        dot.style.height = sz+'px';\n        dot.style.borderRadius = '50%';\n        dot.style.background = `radial-gradient(circle, #000 1px, transparent 2px) 0 0 / 3px 3px`;\n      } else if (t === 'line' || t === 'curve') {\n        const h = [1,2,3,5][i];\n        dot.style.width = '28px';\n        dot.style.height = h+'px';\n        dot.style.background = '#000';\n      } else {\n        const sz = [3,5,8,11][i];\n        dot.style.width = sz+'px';\n        dot.style.height = sz+'px';\n        dot.style.background = '#000';\n        if (t === 'eraser') {\n          dot.style.background = '#fff';\n          dot.style.border = '1px solid #000';\n        }\n      }\n      wrap.appendChild(dot);\n      wrap.addEventListener('mousedown', () => { state.size = i; buildToolOptions(); });\n      toolOptions.appendChild(wrap);\n    });\n    return;\n  }\n\n  // Selection / text / picker / zoom / fill: no options or small hint\n  if (t === 'text') {\n    const hint = document.createElement('div');\n    hint.style.fontSize = '10px';\n    hint.style.textAlign = 'center';\n    hint.style.padding = '4px 2px';\n    hint.style.color = '#000';\n    hint.textContent = 'Drag to draw a text box';\n    toolOptions.appendChild(hint);\n  }\n}\n\n/* ---------- Colors ---------- */\nfunction setFg(c) { state.fg = c; ccFg.style.background = c; }\nfunction setBg(c) { state.bg = c; ccBg.style.background = c; }\n\n/* ---------- Helpers ---------- */\nfunction getPos(e) {\n  const r = canvas.getBoundingClientRect();\n  return {\n    x: Math.floor((e.clientX - r.left) * (canvas.width / r.width)),\n    y: Math.floor((e.clientY - r.top) * (canvas.height / r.height)),\n  };\n}\nfunction brushSize() { return sizes[state.size]; }\nfunction lineWidth() { return [1,2,3,5][state.size]; }\n\nfunction pushUndo() {\n  try {\n    state.undoStack.push(ctx.getImageData(0,0,canvas.width,canvas.height));\n    if (state.undoStack.length > 20) state.undoStack.shift();\n    state.redoStack.length = 0;\n  } catch(e){}\n}\nfunction undo() {\n  if (!state.undoStack.length) return;\n  state.redoStack.push(ctx.getImageData(0,0,canvas.width,canvas.height));\n  const img = state.undoStack.pop();\n  ctx.putImageData(img, 0, 0);\n}\nfunction redo() {\n  if (!state.redoStack.length) return;\n  state.undoStack.push(ctx.getImageData(0,0,canvas.width,canvas.height));\n  const img = state.redoStack.pop();\n  ctx.putImageData(img, 0, 0);\n}\n\nfunction clearOverlay() { octx.clearRect(0,0,overlay.width,overlay.height); }\n\n/* ---------- Drawing primitives ---------- */\nfunction drawPencil(x0, y0, x1, y1) {\n  ctx.fillStyle = state.fg;\n  // Bresenham 1px\n  let dx = Math.abs(x1-x0), dy = Math.abs(y1-y0);\n  let sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1;\n  let err = dx - dy;\n  let x = x0, y = y0;\n  while(true) {\n    ctx.fillRect(x, y, 1, 1);\n    if (x === x1 && y === y1) break;\n    const e2 = 2*err;\n    if (e2 > -dy) { err -= dy; x += sx; }\n    if (e2 < dx) { err += dx; y += sy; }\n  }\n}\n\nfunction drawBrushStroke(x0, y0, x1, y1, color, size) {\n  ctx.fillStyle = color;\n  const r = size;\n  // simple stamped line\n  const dx = x1-x0, dy = y1-y0;\n  const dist = Math.max(Math.abs(dx), Math.abs(dy)) || 1;\n  for (let i = 0; i <= dist; i++) {\n    const t = i/dist;\n    const x = Math.round(x0 + dx*t);\n    const y = Math.round(y0 + dy*t);\n    if (r === 1) ctx.fillRect(x,y,1,1);\n    else ctx.fillRect(x - Math.floor(r/2), y - Math.floor(r/2), r, r);\n  }\n}\n\nfunction spray(x, y, color, size) {\n  ctx.fillStyle = color;\n  const radius = size/2;\n  for (let i = 0; i < sprayDensity; i++) {\n    const ang = Math.random() * Math.PI * 2;\n    const dist = Math.random() * radius;\n    const px = Math.floor(x + Math.cos(ang)*dist);\n    const py = Math.floor(y + Math.sin(ang)*dist);\n    ctx.fillRect(px, py, 1, 1);\n  }\n}\n\nfunction strokeShape(ovctx, drawFn) {\n  ovctx.strokeStyle = state.fg;\n  ovctx.fillStyle = state.bg;\n  ovctx.lineWidth = lineWidth();\n  drawFn(ovctx);\n}\n\nfunction commitShape(drawFn) {\n  pushUndo();\n  ctx.strokeStyle = state.fg;\n  ctx.fillStyle = state.bg;\n  ctx.lineWidth = lineWidth();\n  drawFn(ctx);\n}\n\nfunction drawRectOn(c, x0,y0,x1,y1, style) {\n  const x = Math.min(x0,x1), y = Math.min(y0,y1);\n  const w = Math.abs(x1-x0), h = Math.abs(y1-y0);\n  if (style !== 'outline') c.fillRect(x,y,w,h);\n  if (style !== 'filled') c.strokeRect(x+0.5,y+0.5,w-1,h-1);\n}\nfunction drawEllipseOn(c, x0,y0,x1,y1, style) {\n  const cx = (x0+x1)/2, cy = (y0+y1)/2;\n  const rx = Math.abs(x1-x0)/2, ry = Math.abs(y1-y0)/2;\n  c.beginPath();\n  c.ellipse(cx,cy,rx,ry,0,0,Math.PI*2);\n  if (style !== 'outline') c.fill();\n  if (style !== 'filled') c.stroke();\n}\nfunction drawRRectOn(c, x0,y0,x1,y1, style) {\n  const x = Math.min(x0,x1), y = Math.min(y0,y1);\n  const w = Math.abs(x1-x0), h = Math.abs(y1-y0);\n  const r = Math.min(8, w/2, h/2);\n  c.beginPath();\n  c.moveTo(x+r, y);\n  c.lineTo(x+w-r, y); c.quadraticCurveTo(x+w, y, x+w, y+r);\n  c.lineTo(x+w, y+h-r); c.quadraticCurveTo(x+w, y+h, x+w-r, y+h);\n  c.lineTo(x+r, y+h); c.quadraticCurveTo(x, y+h, x, y+h-r);\n  c.lineTo(x, y+r); c.quadraticCurveTo(x, y, x+r, y);\n  c.closePath();\n  if (style !== 'outline') c.fill();\n  if (style !== 'filled') c.stroke();\n}\nfunction drawLineOn(c, x0,y0,x1,y1) {\n  c.beginPath();\n  c.moveTo(x0+0.5, y0+0.5);\n  c.lineTo(x1+0.5, y1+0.5);\n  c.stroke();\n}\n\n/* ---------- Flood fill ---------- */\nfunction floodFill(x, y, fillColor) {\n  pushUndo();\n  const w = canvas.width,