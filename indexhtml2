900\"`;\n\n  // build extrude layers behind\n  let extLayers = '';\n  if (extrude) {\n    for (let i = extrude.steps; i >= 1; i--) {\n      const dx = (extrude.dx || 1) * i;\n      const dy = (extrude.dy || 1) * i;\n      const col = extrude.color || '#444';\n      extLayers += `<text ${txtCommon} fill=\"${col}\" stroke=\"${extrude.stroke||col}\" stroke-width=\"${extrude.strokeWidth||0.5}\" transform=\"translate(${dx} ${dy})\">${_esc(text)}<\u002Ftext>`;\n    }\n  }\n\n  // shadow\n  let shadowLayer = '';\n  if (shadow) {\n    shadowLayer = `<text ${txtCommon} fill=\"${shadow.color||'#000'}\" opacity=\"${shadow.opacity||0.55}\" transform=\"translate(${shadow.dx||3} ${shadow.dy||3})\">${_esc(text)}<\u002Ftext>`;\n  }\n\n  // main text\n  const strokeAttr = stroke ? ` stroke=\"${stroke}\" stroke-width=\"${strokeWidth||1}\" stroke-linejoin=\"round\" paint-order=\"stroke\"` : '';\n  const filterAttr = filterId ? ` filter=\"url(#${filterId})\"` : '';\n  const mainText = `<text ${txtCommon} fill=\"${usedFill||'#000'}\"${strokeAttr}${filterAttr}>${_esc(text)}<\u002Ftext>`;\n\n  const tg = transform ? ` transform=\"${transform}\"` : '';\n\n  return `<svg viewBox=\"0 0 ${w} ${h}\" xmlns=\"http://www.w3.org/2000/svg\" preserveAspectRatio=\"xMidYMid meet\">${defs?`<defs>${defs}<\u002Fdefs>`:''}<g${tg}>${before||''}${shadowLayer}${extLayers}${mainText}${after||''}<\u002Fg><\u002Fsvg>`;\n}\n\n/* Specialized renderers (arch, wave, vertical, chrome with multi-grad, etc.) */\n\nfunction _renderArch(text, font, size, opts = {}) {\n  text = text || '';\n  const measureW = _measureText(text, font, size);\n  const w = Math.max(measureW + 60, size * 4);\n  const h = size * 2.2;\n  const pathId = _rid();\n  // Upward arch path\n  const ax = 20, ay = h * 0.95, ex = w - 20, ey = h * 0.95;\n  const cx = w/2, cy = h * 0.15;\n  const d = `M ${ax} ${ay} Q ${cx} ${cy} ${ex} ${ey}`;\n  const fill = opts.fill || '#1d4ed8';\n  const stroke = opts.stroke || '#000';\n  return `<svg viewBox=\"0 0 ${w