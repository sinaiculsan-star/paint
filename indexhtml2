'clear': pushUndo(); clearCanvas(); break;\n    case 'flipH': {\n      pushUndo();\n      const tmp = document.createElement('canvas');\n      tmp.width = canvas.width; tmp.height = canvas.height;\n      tmp.getContext('2d').drawImage(canvas, 0,0);\n      ctx.save();\n      ctx.translate(canvas.width, 0); ctx.scale(-1, 1);\n      ctx.drawImage(tmp, 0, 0);\n      ctx.restore();\n      break;\n    }\n    case 'flipV': {\n      pushUndo();\n      const tmp = document.createElement('canvas');\n      tmp.width = canvas.width; tmp.height = canvas.height;\n      tmp.getContext('2d').drawImage(canvas, 0,0);\n      ctx.save();\n      ctx.translate(0, canvas.height); ctx.scale(1, -1);\n      ctx.drawImage(tmp, 0, 0);\n      ctx.restore();\n      break;\n    }\n    case 'invert': {\n      pushUndo();\n      const img = ctx.getImageData(0,0,canvas.width,canvas.height);\n      for (let i=0; i<img.data.length; i+=4) {\n        img.data[i] = 255-img.data[i];\n        img.data[i+1] = 255-img.data[i+1];\n        img.data[i+2] = 255-img.data[i+2];\n      }\n      ctx.putImageData(img,0,0);\n      break;\n    }\n    case 'save': {\n      const a = document.createElement('a');\n      a.download = 'untitled.png';\n      a.href = canvas.toDataURL('image/png');\n      a.click();\n      break;\n    }\n    case 'attributes': {\n      const w = prompt('Width:', canvas.width);\n      const h = prompt('Height:', canvas.height);\n      if (w && h) resizeCanvas(parseInt(w), parseInt(h));\n      break;\n    }\n    case 'about':\n      document.getElementById('aboutModal').classList.add('open');\n      break;\n    case 'camera':\n      openCameraModal();\n      break;\n  }\n}\n\n/* ---------- Camera capture ---------- */\nconst camModal = document.getElementById('cameraModal');\nconst camVideo = document.getElementById('camVideo');\nconst camPreview = document.getElementById('camPreview');\nconst camStatus = document.getElementById('camStatus');\nconst camFlash = document.getElementById('camFlash');\nconst camRecDot = document.getElementById('camRecDot');\nconst camStartBtn = document.getElementById('camStartBtn');\nconst camSnapBtn = document.getElementById('camSnapBtn');\nconst camRetakeBtn = document.getElementById('camRetakeBtn');\nconst camInsertBtn = document.getElementById('camInsertBtn');\nconst camCancelBtn = document.getElementById('camCancelBtn');\nconst camDither = document.getElementById('camDither');\nconst camGray = document.getElementById('camGray');\nlet camStream = null;\nlet camHasShot = false;\nlet camRecBlink = null;\n\nfunction openCameraModal() {\n  camModal.classList.add('open');\n  camHasShot = false;\n  camPreview.style.display = 'none';\n  camVideo.style.display = 'block';\n  camSnapBtn.style.display = 'inline-flex';\n  camRetakeBtn.style.display = 'none';\n  camInsertBtn.style.display = 'none';\n  if (!camStream) {\n    camStatus.style.display = 'flex';\n    camStartBtn.style.display = 'inline-flex';\n  } else {\n    camStatus.style.display = 'none';\n    camStartBtn.style.display = 'none';\n  }\n}\n\nfunction closeCameraModal() {\n  camModal.classList.remove('open');\n  if (camStream) {\n    camStream.getTracks().forEach(t => t.stop());\n    camStream = null;\n  }\n  if (camRecBlink) { clearInterval(camRecBlink); camRecBlink = null; camRecDot.textContent = ''; }\n}\n\nasync function startCamera() {\n  camStatus.textContent = 'Requesting camera...';\n  try {\n    camStream = await navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240 }, audio: false });\n    camVideo.srcObject = camStream;\n    camStatus.style.display = 'none';\n    camStartBtn.style.display = 'none';\n    // blinking REC dot\n    let on = true;\n    camRecBlink = setInterval(() => {\n      camRecDot.textContent = on ? '\\u25CF REC' : '';\n      on = !on;\n    }, 600);\n  } catch (err) {\n    camStatus.innerHTML = 'Camera unavailable.<br>' + (err.message || err.name);\n    camStatus.style.color = '#ff8080';\n  }\n}\n\nfunction snapPhoto() {\n  if (!camStream) return;\n  // flash effect\n  camFlash.style.transition = 'none';\n  camFlash.style.opacity = '1';\n  setTimeout(() => { camFlash.style.transition = 'opacity 400ms'; camFlash.style.opacity = '0'; }, 30);\n\n  const pctx = camPreview.getContext('2d');\n  pctx.drawImage(camVideo, 0, 0, camPreview.width, camPreview.height);\n  applyCamEffects(pctx);\n  camPreview.style.display = 'block';\n  camVideo.style.display = 'none';\n  camSnapBtn.style.display = 'none';\n  camRetakeBtn.style.display = 'inline-flex';\n  camInsertBtn.style.display = 'inline-flex';\n  camHasShot = true;\n}\n\nfunction applyCamEffects(pctx) {\n  if (!camGray.checked && !camDither.checked) return;\n  const img = pctx.getImageData(0,0,camPreview.width, camPreview.height);\n  const d = img.data;\n  const w = camPreview.width, h = camPreview.height;\n  // grayscale\n  for (let i = 0; i < d.length; i += 4) {\n    const g = 0.299*d[i] + 0.587*d[i+1] + 0.114*d[i+2];\n    d[i] = d[i+1] = d[i+2] = g;\n  }\n  if (camDither.checked) {\n    // Floyd-Steinberg dither to 1-bit\n    const buf = new Float32Array(w*h);\n    for (let y=0; y<h; y++) for (let x=0; x<w; x++) buf[y*w+x] = d[(y*w+x)*4];\n    for (let y=0; y<h; y++) {\n      for (let x=0; x<w; x++) {\n        const old = buf[y*w+x];\n        const ne = old < 128 ? 0 : 255;\n        buf[y*w+x] = ne;\n        const err = old - ne;\n        if (x+1<w) buf[y*w+x+1] += err*7/16;\n        if (y+1<h) {\n          if (x>0) buf[(y+1)*w+x-1] += err*3/16;\n          buf[(y+1)*w+x] += err*5/16;\n          if (x+1<w) buf[(y+1)*w+x+1] += err*1/16;\n        }\n      }\n    }\n    for (let i = 0; i < w*h; i++) {\n      d[i*4] = d[i*4+1] = d[i*4+2] = buf[i];\n    }\n  }\n  pctx.putImageData(img,0,0);\n}\n\nfunction retake() {\n  camPreview.style.display = 'none';\n  camVideo.style.display = 'block';\n  camSnapBtn.style.display = 'inline-flex';\n  camRetakeBtn.style.display = 'none';\n  camInsertBtn.style.display = 'none';\n  camHasShot = false;\n}\n\nfunction insertPhoto() {\n  if (!camHasShot) return;\n  pushUndo();\n  // fit centered into canvas, preserving aspect, max 70% of canvas\n  const cw = canvas.width, ch = canvas.height;\n  const maxW = cw * 0.75, maxH = ch * 0.75;\n  const ratio = Math.min(maxW / camPreview.width, maxH / camPreview.height);\n  const w = Math.round(camPreview.width * ratio);\n  const h = Math.round(camPreview.height * ratio);\n  const x = Math.round((cw - w) / 2);\n  const y = Math.round((ch - h) / 2);\n  ctx.imageSmoothingEnabled = false;\n  ctx.drawImage(camPreview, x, y, w, h);\n  closeCameraModal();\n}\n\ncamStartBtn.addEventListener('mousedown', startCamera);\ncamSnapBtn.addEventListener('mousedown', snapPhoto);\ncamRetakeBtn.addEventListener('mousedown', retake);\ncamInsertBtn.addEventListener('mousedown', insertPhoto);\ncamCancelBtn.addEventListener('mousedown', closeCameraModal);\ndocument.getElementById('closeCamera').addEventListener('mousedown', closeCameraModal);\n\ndocument.getElementById('closeAbout').addEventListener('mousedown', () => document.getElementById('aboutModal').classList.remove('open'));\ndocument.getElementById('closeAboutOk').addEventListener('mousedown', () => document.getElementById('aboutModal').classList.remove('open'));\n\n/* ---------- Resize canvas ---------- */\nfunction resizeCanvas(w, h) {\n  const tmp = document.createElement('canvas');\n  tmp.width = canvas.width; tmp.height = canvas.height;\n  tmp.getContext('2d').drawImage(canvas, 0, 0);\n  canvas.width = w; canvas.height = h;\n  overlay.width = w; overlay.height = h;\n  clearCanvas();\n  ctx.drawImage(tmp, 0, 0);\n  sbSize.textContent = `${w} x ${h}`;\n}\n\n/* Resize handles */\nlet resizing = null;\ndocument.querySelectorAll('.resize-handle').forEach(h => {\n  h.addEventListener('mousedown', (e) => {\n    resizing = { dir: h.dataset.rh, startX: e.clientX, startY: e.clientY, w: canvas.width, h: canvas.height };\n    e.preventDefault();\n    e.stopPropagation();\n  });\n});\ndocument.addEventListener('mousemove', (e) => {\n  if (!resizing) return;\n  let nw = resizing.w, nh = resizing.h;\n  if (resizing.dir.includes('e')) nw = Math.max(50, resizing.w + (e.clientX - resizing.startX));\n  if (resizing.dir.includes('s')) nh = Math.max(50, resizing.h + (e.clientY - resizing.startY));\n  sbSize.textContent = `${nw} x ${nh}`;\n  canvasFrame.style.width = nw + 'px';\n  canvasFrame.style.height = nh + 'px';\n});\ndocument.addEventListener('mouseup', (e) => {\n  if (resizing) {\n    let nw = resizing.w, nh = resizing.h;\n    if (resizing.dir.includes('e')) nw = Math.max(50, resizing.w + (e.clientX - resizing.startX));\n    if (resizing.dir.includes('s')) nh = Math.max(50, resizing.h + (e.clientY - resizing.startY));\n    resizeCanvas(nw, nh);\n    canvasFrame.style.width = ''; canvasFrame.style.height = '';\n    resizing = null;\n  }\n});\n\n/* ---------- Keyboard ---------- */\ndocument.addEventListener('keydown', (e) => {\n  if (state.textBox && document.activeElement === state.textBox) return;\n  if (e.ctrlKey || e.metaKey) {\n    if (e.key === 'z') { e.preventDefault(); undo(); }\n    else if (e.key === 'y') { e.preventDefault(); redo(); }\n    else if (e.key === 'n') { e.preventDefault(); clearCanvas(); }\n    else if (e.key === 's') { e.preventDefault(); runAction('save'); }\n    else if (e.key === 'i') { e.preventDefault(); runAction('invert'); }\n    else if (e.key === 'm') { e.preventDefault(); runAction('camera'); }\n  } else if (e.key === 'Escape') {\n    finishPendingOps();\n  }\n});\n\n/* ---------- Init ---------- */\nsetTool('pencil');\nsetFg('#000000');\nsetBg('#ffffff');\nsbSize.textContent = `${canvas.width} x ${canvas.height}`;\n\n/* ===================================================================\n   STICKERS — purple toolbar button + Win95-style picker dialog\n   =================================================================== */\n\n/* ---------- Pixel-art helper ---------- */\n/* Tiny pixel-art format: rows of single chars; '.' = transparent;\n   palette maps each char -> hex color. Renders as crisp SVG. */\nfunction pxArt(rows, palette) {\n  const h = rows.length;\n  const w = rows[0].length;\n  let s = '';\n  for (let y = 0; y < h; y++) {\n    for (let x = 0; x < w; x++) {\n      const c = rows[y][x];\n      if (c === '.' || c === ' ') continue;\n      const fill = palette[c];\n      if (!fill) continue;\n      s += `<rect x=\"${x}\" y=\"${y}\" width=\"1\" height=\"1\" fill=\"${fill}\"/>`;\n    }\n  }\n  return `<svg viewBox=\"0 0 ${w} ${h}\" shape-rendering=\"crispEdges\" xmlns=\"http://www.w3.org/2000/svg\">${s}<\u002Fsvg>`;\n}\n\n/* ---------- A few hand-crafted pixel-art sprites ---------- */\n/* Pixel cat — orange tabby */\nconst catOrange = pxArt([\n  '..A..A..',\n  '.ABABAB.',\n  'ABBBBBBA',\n  'AKBKBBKBA'.slice(0,8),\n  'ABBBBBBA',\n  'ABPBBPBA',\n  'ABBBBBBA',\n  '.ABBBBA.',\n], { A:'#d97706', B:'#fbbf24', K:'#000', P:'#ec4899' });\n\nconst catGray = pxArt([\n  '..A..A..',\n  '.ABABAB.',\n  'ABBBBBBA',\n  'ABKBBKBA',\n  'ABBBBBBA',\n  'ABPBBPBA',\n  'ABBBBBBA',\n  '.ABBBBA.',\n], { A:'#4b5563', B:'#9ca3af', K:'#000', P:'#ec4899' });\n\nconst catBlack = pxArt([\n  '..A..A..',\n  '.AAAAAA.',\n  'AAAAAAAA',\n  'AGAAAGAA'.slice(0,8),\n  'AAAAAAAA',\n  'AAPAAPAA'.slice(0,8),\n  'AAAAAAAA',\n  '.AAAAAA.',\n], { A:'#111', G:'#fde68a', P:'#ec4899' });\n\nconst catWhite = pxArt([\n  '..A..A..',\n  '.ABABAB.',\n  'ABBBBBBA',\n  'ABKBBKBA',\n  'ABBBBBBA',\n  'ABPBBPBA',\n  'ABBBBBBA',\n  '.ABBBBA.',\n], { A:'#9ca3af', B:'#ffffff', K:'#000', P:'#fda4af' });\n\n/* Pixel ghost */\nconst ghostClassic = pxArt([\n  '..AAAA..',\n  '.AAAAAA.',\n  'AAKAKAAA'.slice(0,8),\n  'AAAAAAAA',\n  'AAPAAPAA'.slice(0,8),\n  'AAAAAAAA',\n  'AAAAAAAA',\n  'A.A.A.A.',\n], { A:'#ffffff', K:'#000', P:'#ec4899' });\n\n/* Floppy disk */\nconst floppy = pxArt([\n  'BBBBBBBB',\n  'BWWWWWBB',\n  'BWAAAWBB',\n  'BWAAAWBB',\n  'BWWWWWBB',\n  'BBBBBBBB',\n  'BLLLLLBB',\n  'BBBBBBBB',\n], { B:'#1f2937', W:'#9ca3af', A:'#111', L:'#e5e7eb'