yle = state.fg; ctx.fillStyle = state.bg; ctx.lineWidth = lineWidth();\n    ctx.beginPath();\n    ctx.moveTo(state.polyPts[0][0]+0.5, state.polyPts[0][1]+0.5);\n    for (let i = 1; i < state.polyPts.length; i++) ctx.lineTo(state.polyPts[i][0]+0.5, state.polyPts[i][1]+0.5);\n    ctx.lineTo(p.x+0.5, p.y+0.5);\n    ctx.closePath();\n    if (state.shapeStyle !== 'outline') ctx.fill();\n    if (state.shapeStyle !== 'filled') ctx.stroke();\n    state.polyPts = [];\n  }\n});\n\ncanvas.addEventListener('contextmenu', e => e.preventDefault());\ncanvas.addEventListener('mouseleave', () => { sbCoord.textContent = ''; });\n\n/* ---------- Text tool ---------- */\nfunction createTextBox(x0,y0,x1,y1) {\n  if (state.textBox) state.textBox.remove();\n  const x = Math.min(x0,x1), y = Math.min(y0,y1);\n  const w = Math.max(60, Math.abs(x1-x0));\n  const h = Math.max(20, Math.abs(y1-y0));\n  const ta = document.createElement('textarea');\n  ta.className = 'text-edit';\n  ta.style.left = x + 'px';\n  ta.style.top = y + 'px';\n  ta.style.width = w + 'px';\n  ta.style.height = h + 'px';\n  ta.style.color = state.fg;\n  canvasFrame.appendChild(ta);\n  ta.focus();\n  state.textBox = ta;\n  ta.addEventListener('blur', commitText);\n}\nfunction commitText() {\n  const ta = state.textBox;\n  if (!ta) return;\n  const txt = ta.value;\n  if (txt) {\n    pushUndo();\n    const x = parseFloat(ta.style.left);\n    const y = parseFloat(ta.style.top);\n    const w = parseFloat(ta.style.width);\n    ctx.fillStyle = state.fg;\n    ctx.font = '14px \"MS Sans Serif\", Tahoma, sans-serif';\n    ctx.textBaseline = 'top';\n    // wrap text manually\n    const lines = txt.split('\\n');\n    let yy = y + 4;\n    lines.forEach(line => {\n      const words = line.split(' ');\n      let row = '';\n      words.forEach(word => {\n        const test = row ? row + ' ' + word : word;\n        if (ctx.measureText(test).width > w - 8) {\n          ctx.fillText(row, x+4, yy);\n          yy += 16;\n          row = word;