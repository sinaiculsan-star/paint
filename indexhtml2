name: '90s Things',\n    catIcon: S(floppy),\n    stickers: [\n      S(floppy), S(cassette), S(pxHeart),\n      E('💾'), E('📼'), E('💿'), E('📀'),\n      E('⭐'), E('☀️'), E('🌈'), E('🍭'),\n      E('🎀'), E('🎵'), E('📞'), E('☎️'),\n    ]\n  },\n  {\n    id: '90chars', name: '90s Chars',\n    catIcon: S(pixMonster),\n    stickers: [\n      S(pixRobot), S(pixAlien), S(pixMonster),\n      S(pixNinja), S(pixHero), S(pixWizard),\n      E('🤖'), E('👾'), E('🦸'), E('🦹'),\n      E('🧙'), E('🐉'),\n    ]\n  },\n  {\n    id: '90tech', name: '90s Tech',\n    catIcon: S(crtTV),\n    stickers: [\n      S(crtTV), S(controller), S(cdDisc), S(gameCart), S(beeper),\n      E('📺'), E('📻'), E('🎮'),\n      E('🕹️'), E('📠'), E('💽'), E('🖨️'),\n    ]\n  },\n  {\n    id: 'hearts', name: 'Hearts',\n    catIcon: S(pxHeart),\n    stickers: [\n      S(pxHeart),\n      E('❤️'), E('🧡'), E('💛'), E('💚'),\n      E('💙'), E('💜'), E('🖤'), E('🤍'),\n      E('💖'), E('💗'), E('💕'), E('💘'),\n      E('💝'), E('💟'),\n    ]\n  },\n  {\n    id: 'food', name: 'Food',\n    catIcon: E('🍔'),\n    stickers: [\n      E('🍔'), E('🍟'), E('🍕'), E('🌭'),\n      E('🍿'), E('🍩'), E('🍪'), E('🍰'),\n      E('🍦'), E('🍭'), E('🍫'), E('🥤'),\n      E('🍎'), E('🍌'), E('🍓'), E('🥑'),\n    ]\n  },\n  {\n    id: 'misc', name: 'Misc',\n    catIcon: E('⭐'),\n    stickers: [\n      E('⭐'), E('🌟'), E('✨'), E('💫'),\n      E('🎉'), E('🎊'), E('🎁'), E('🎈'),\n      E('🌈'), E('☀️'), E('🌙'), E('☁️'),\n      E('🔥'), E('💥'), E('💯'), E('❓'),\n    ]\n  },\n];\n\n/* ---------- Sticker state ---------- */\nconst stickerState = {\n  activeCatId: 'cats',\n  selectedIdx: -1,         // index inside current category\n  selectedSticker: null,   // sticker object to be placed\n  placing: false,          // canvas placement mode\n};\n\n/* ---------- DOM refs ---------- */\nconst stickerModal = document.getElementById('stickerModal');\nconst stickerCatsEl = document.getElementById('stickerCats');\nconst stickerGridEl = document.getElementById('stickerGrid');\nconst stickerCatNameEl = document.getElementById('stickerCatName');\nconst stickerBtn = document.getElementById('stickerBtn');\nconst stickerInsertBtn = document.getElementById('stickerInsertBtn');\nconst stickerCancelBtn = document.getElementById('stickerCancelBtn');\nconst closeStickers = document.getElementById('closeStickers');\nconst stickerGhost = document.getElementById('stickerGhost');\n\n/* ---------- Render category list ---------- */\nfunction renderStickerCats() {\n  stickerCatsEl.innerHTML = '';\n  stickerCategories.forEach(cat => {\n    const row = document.createElement('div');\n    row.className = 'sticker-cat-row' + (cat.id === stickerState.activeCatId ? ' active' : '');\n    row.dataset.cat = cat.id;\n    const ico = document.createElement('div');\n    ico.className = 'cat-ico';\n    if (cat.catIcon.e) ico.textContent = cat.catIcon.e;\n    else if (cat.catIcon.s) ico.innerHTML = cat.catIcon.s;\n    else if (cat.catIcon.i) {\n      const im = document.createElement('img');\n      im.src = resolveImg(cat.catIcon.i);\n      im.style.cssText = 'width:16px;height:16px;object-fit:contain;';\n      ico.appendChild(im);\n    }\n    const label = document.createElement('span');\n    label.textContent = cat.name;\n    row.appendChild(ico);\n    row.appendChild(label);\n    row.addEventListener('mousedown', () => {\n      stickerState.activeCatId = cat.id;\n      stickerState.selectedIdx = -1;\n      stickerState.selectedSticker = null;\n      updateInsertBtn();\n      renderStickerCats();\n      renderStickerGrid();\n    });\n    stickerCatsEl.appendChild(row);\n  });\n}\n\n/* ---------- Render sticker grid ---------- */\nfunction renderStickerGrid() {\n  const cat = stickerCategories.find(c => c.id === stickerState.activeCatId);\n  if (!cat) return;\n  stickerCatNameEl.textContent = cat.name;\n  stickerGridEl.innerHTML = '';\n  cat.stickers.forEach((st, i) => {\n    const cell = document.createElement('div');\n    cell.className = 'sticker-cell' + (i === stickerState.selectedIdx ? ' selected' : '') + (cat.sparkly ? ' sparkly' : '');\n    if (st.e) cell.textContent = st.e;\n    else if (st.s) cell.innerHTML = st.s;\n    else if (st.i) {\n      const im = document.createElement('img');\n      im.src = resolveImg(st.i);\n      im.alt = '';\n      im.draggable = false;\n      cell.appendChild(im);\n    }\n    // Add sparkle stars on top for sparkly categories\n    if (cat.sparkly) {\n      ['s1','s2','s3','s4'].forEach(cls => {\n        const star = document.createElement('div');\n        star.className = 'star ' + cls;\n        star.innerHTML = sparkleStarSvg;\n        cell.appendChild(star);\n      });\n    }\n    cell.addEventListener('mousedown', () => {\n      stickerState.selectedIdx = i;\n      stickerState.selectedSticker = st;\n      stickerState.selectedSparkly = !!cat.sparkly;\n      updateInsertBtn();\n      renderStickerGrid();\n    });\n    cell.addEventListener('dblclick', () => {\n      stickerState.selectedIdx = i;\n      stickerState.selectedSticker = st;\n      stickerState.selectedSparkly = !!cat.sparkly;\n      confirmStickerSelection();\n    });\n    stickerGridEl.appendChild(cell);\n  });\n}\n\nfunction updateInsertBtn() {\n  if (stickerState.selectedSticker) stickerInsertBtn.classList.remove('disabled');\n  else stickerInsertBtn.classList.add('disabled');\n}\n\n/* ---------- Open / close picker ---------- */\nfunction openStickerPicker() {\n  stickerModal.classList.add('open');\n  stickerBtn.classList.add('active');\n  stickerState.selectedIdx = -1;\n  stickerState.selectedSticker = null;\n  updateInsertBtn();\n  renderStickerCats();\n  renderStickerGrid();\n}\nfunction closeStickerPicker() {\n  stickerModal.classList.remove('open');\n  stickerBtn.classList.remove('active');\n}\n\nstickerBtn.addEventListener('mousedown', openStickerPicker);\ncloseStickers.addEventListener('mousedown', closeStickerPicker);\nstickerCancelBtn.addEventListener('mousedown', closeStickerPicker);\nstickerInsertBtn.addEventListener('mousedown', () => {\n  if (stickerInsertBtn.classList.contains('disabled')) return;\n  confirmStickerSelection();\n});\n\nfunction confirmStickerSelection() {\n  if (!stickerState.selectedSticker) return;\n  closeStickerPicker();\n  enterStickerPlaceMode(stickerState.selectedSticker);\n}\n\n/* ---------- Placement mode ---------- */\nfunction enterStickerPlaceMode(st) {\n  stickerState.placing = true;\n  document.querySelector('.canvas-wrap').classList.add('placing');\n  // populate ghost preview\n  stickerGhost.innerHTML = '';\n  if (st.e) stickerGhost.textContent = st.e;\n  else if (st.s) stickerGhost.innerHTML = st.s;\n  else if (st.i) {\n    const im = document.createElement('img');\n    im.src = resolveImg(st.i);\n    stickerGhost.appendChild(im);\n  }\n  stickerGhost.classList.add('show');\n  stickerGhost.classList.toggle('sparkly', !!stickerState.selectedSparkly);\n  sbHelp.textContent = 'Click on the canvas to place the sticker. Esc to cancel.';\n}\n\nfunction exitStickerPlaceMode() {\n  stickerState.placing = false;\n  stickerGhost.classList.remove('show');\n  document.querySelector('.canvas-wrap').classList.remove('placing');\n  // restore tool help text\n  const t = toolDefs.find(t => t.id === state.tool);\n  if (t) sbHelp.textContent = `${t.name} — ` + helpFor(state.tool);\n}\n\n/* track ghost position over canvas */\ncanvas.addEventListener('mousemove', (e) => {\n  if (!stickerState.placing) return;\n  const r = canvasFrame.getBoundingClientRect();\n  stickerGhost.style.left = (e.clientX - r.left) + 'px';\n  stickerGhost.style.top  = (e.clientY - r.top) + 'px';\n});\n\n/* place on click — capture phase so it intercepts before drawing tools */\ncanvas.addEventListener('mousedown', (e) => {\n  if (!stickerState.placing) return;\n  e.stopImmediatePropagation();\n  e.preventDefault();\n  const p = getPos(e);\n  placeSticker(stickerState.selectedSticker, p.x, p.y);\n  exitStickerPlaceMode();\n}, true);\n\n/* Esc cancels placement */\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'Escape' && stickerState.placing) {\n    exitStickerPlaceMode();\n  }\n});\n\n/* ---------- Render a sticker into the canvas ---------- */\nfunction placeSticker(st, cx, cy) {\n  pushUndo();\n  const sparkly = !!stickerState.selectedSparkly;\n  if (st.e) {\n    const size = 64;\n    const tmp = document.createElement('canvas');\n    tmp.width = size; tmp.height = size;\n    const tctx = tmp.getContext('2d');\n    tctx.imageSmoothingEnabled = false;\n    tctx.textAlign = 'center';\n    tctx.textBaseline = 'middle';\n    tctx.font = (size * 0.85) + 'px \"Segoe UI Emoji\",\"Apple Color Emoji\",\"Noto Color Emoji\",sans-serif';\n    tctx.fillText(st.e, size/2, size/2 + 2);\n    ctx.imageSmoothingEnabled = false;\n    ctx.drawImage(tmp, cx - size/2, cy - size/2);\n    if (sparkly) drawSparklesAround(cx, cy, size);\n  } else if (st.s) {\n    const size = 64;\n    const blob = new Blob([st.s], { type: 'image/svg+xml' });\n    const url = URL.createObjectURL(blob);\n    const img = new Image();\n    img.onload = () => {\n      ctx.imageSmoothingEnabled = false;\n      ctx.drawImage(img, cx - size/2, cy - size/2, size, size);\n      if (sparkly) drawSparklesAround(cx, cy, size);\n      URL.revokeObjectURL(url);\n    };\n    img.onerror = () => URL.revokeObjectURL(url);\n    img.src = url;\n  } else if (st.i) {\n    // Image sticker — larger size, preserve aspect, with sparkles for Lizzie\n    const targetW = 120;\n    const img = new Image();\n    img.crossOrigin = 'anonymous';\n    img.onload = () => {\n      const aspect = img.naturalHeight / img.naturalWidth;\n      const w = targetW;\n      const h = Math.round(targetW * aspect);\n      ctx.imageSmoothingEnabled = true;\n      ctx.drawImage(img, cx - w/2, cy - h/2, w, h);\n      if (sparkly) drawSparklesAround(cx, cy, Math.max(w, h));\n    };\n    img.src = resolveImg(st.i);\n  }\n}\n\n/* Draw a few twinkly 5-point stars around (cx,cy) within radius ~size */\nfunction drawSparklesAround(cx, cy, size) {\n  const r = size * 0.65;\n  const stars = [\n    { dx: -r*0.95, dy: -r*0.55, s: 9,  color: '#fde047' },\n    { dx:  r*0.85, dy: -r*0.75, s: 7,  color: '#fff7a0' },\n    { dx:  r*0.95, dy:  r*0.45, s: 8,  color: '#fde047' },\n    { dx: -r*0.55, dy:  r*0.95, s: 6,  color: '#fcd34d' },\n    { dx:  r*0.20, dy: -r*1.05, s: 5,  color: '#fffbcc' },\n    { dx: -r*1.05, dy:  r*0.15, s: 6,  color: '#fde047' },\n  ];\n  ctx.save();\n  for (const st of stars) {\n    drawStar(ctx, cx + st.dx, cy + st.dy, st.s, st.color);\n  }\n  ctx.restore();\n}\nfunction drawStar(c, x, y, size, fill) {\n  c.save();\n  c.translate(x, y);\n  c.fillStyle = fill;\n  c.strokeStyle = '#a16207';\n  c.lineWidth = 0.8;\n  c.beginPath();\n  const spikes = 5;\n  for (let i = 0; i < spikes * 2; i++) {\n    const r = i % 2 === 0 ? size : size * 0.42;\n    const ang = (Math.PI / spikes) * i - Math.PI / 2;\n    const px = Math.cos(ang) * r;\n    const py = Math.sin(ang) * r;\n    if (i === 0) c.moveTo(px, py); else c.lineTo(px, py);\n  }\n  c.closePath();\n  c.fill();\n  c.stroke();\n  c.restore();\n}\n\n/* Click outside modal closes it */\nstickerModal.addEventListener('mousedown', (e) => {\n  if (e.target === stickerModal) closeStickerPicker();\n});\n\n/* ===================================================================\n   FANCY TEXT — styled-text gallery + input + floating canvas element\n   =================================================================== */\n\n/* ---------- Style configs ----------\n   Each style has: id, name, and a render(text, fontFamily, fontSize) -> SVG string.\n   Renders include classics: outline+shadow, gradients, 3D extrude, arch, wave,\n   vertical stack, chrome, neon, marble, pink bubble, etc.\n*/\nfunction _esc(s) { return String(s).replace(/&/g,'&amp;').replace(/<\u002Fg,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); }\nfunction _rid() { return 'g' + Math.random().toString(36).slice(2, 9); }\n\n/* Approximate text width (px) given font size — for S